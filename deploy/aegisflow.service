[Unit]
Description=AegisFlow Carrier-Grade Flow Intelligence & DDoS Defense Engine
Documentation=https://github.com/shuvosarker2020/Network-Traffic-Flow-Analysis-Engine
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aegisflow
Group=aegisflow
WorkingDirectory=/opt/aegisflow
Environment="PATH=/opt/aegisflow/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/opt/aegisflow/venv/bin/python run.py

# Auto-restart policy
Restart=always
RestartSec=5s

# File descriptor & process limits for carrier-grade flow reception
LimitNOFILE=1048576
LimitNPROC=65535

# Linux capabilities to bind to ports < 1024 if needed without running as root
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Sandboxing & security hardening
ProtectSystem=full
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
